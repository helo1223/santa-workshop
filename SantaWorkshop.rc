#include <winres.h>
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 VERSIONINFO
 FILEVERSION SANTAWORKSHOP_VERSION_NUMERIC
 PRODUCTVERSION SANTAWORKSHOP_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SantaWorkshop map editor"
            VALUE "FileVersion", SANTAWORKSHOP_VERSION
            VALUE "InternalName", "SantaWorkshop"
            VALUE "OriginalFilename", "SantaWorkshop.exe"
            VALUE "ProductName", "SantaWorkshop"
            VALUE "ProductVersion", SANTAWORKSHOP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
